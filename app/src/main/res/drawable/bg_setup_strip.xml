<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.19：横屏专用的「细条」底。

  bg_setup_box 自带 16dp 四边内边距，那是给卡片用的；状态条只有一行字，
  套上去上下白吃 32dp —— 横屏高度本来就紧，一条状态吃掉纵向 1/4 就是这么来的。
  这条只留 8dp / 14dp，一行字刚好贴住。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/setup_card" />
    <stroke android:width="1dp" android:color="@color/setup_border" />
    <corners android:radius="12dp" />
    <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
</shape>
