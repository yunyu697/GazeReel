<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.45：片库卡片重做。

  上一版一张卡上挤了 5 个 12sp / 32dp 的文字 chip（加文件夹、编辑、重扫、删除、
  隐藏），右对齐、彼此只隔 8dp，「删除」就贴着「重扫」。用户要么点不中，要么误删。
  这一版：
  · 第一行给真实信息：类型 + 视频数 + 地址缩略，右上角一个 48dp 的「更多」；
  · 第二行只放 3 个常做的动作，每个 48dp 高、等宽、带按下反馈；
  · 编辑 = 点整张卡，删除收进「更多」并二次确认，不再暴露成随手可用的按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:minHeight="76dp"
    android:padding="14dp"
    android:orientation="vertical"
    android:background="@drawable/bg_setup_box"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/sourceDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_setup_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sourceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textColor="@color/setup_text" />

            <TextView
                android:id="@+id/sourceSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/setup_muted" />

            <TextView
                android:id="@+id/sourceAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:visibility="gone"
                android:textColor="@color/setup_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/sourceChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_setup_chip_solid"
            android:textSize="11sp"
            android:textColor="@color/setup_cyan" />

        <ImageButton
            android:id="@+id/sourceMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_setup_more"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sourceRescan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_setup_action"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/source_action_rescan"
            android:textSize="13sp"
            android:textColor="@color/setup_text" />

        <TextView
            android:id="@+id/sourceAddFolder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_setup_action"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/source_action_folder"
            android:textSize="13sp"
            android:textColor="@color/setup_cyan" />

        <TextView
            android:id="@+id/sourceHide"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_setup_action"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/setup_hide"
            android:textSize="13sp"
            android:textColor="@color/setup_text" />
    </LinearLayout>

</LinearLayout>
