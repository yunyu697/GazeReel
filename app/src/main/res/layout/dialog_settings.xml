<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.45：设置对话框收紧。
  上一版是「标题 + 两段近百字说明 + 滑杆 + ± + 重置 + 又两段说明 + 倒计时 + 长说明 + 完成」，
  小屏上要滚两次才摸到「完成」。现在每项一行数值、一行操作、一行短说明，
  长解释只留一句，按钮统一 48dp。id 全部沿用，SetupActivity.showSettings 不用改。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/setup_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/setup_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_lead"
            android:textSize="12sp"
            android:textColor="@color/setup_muted" />

        <!-- 瞳距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_ipd"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/setup_text" />

            <TextView
                android:id="@+id/ipdValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="80dp"
                android:gravity="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/setup_cyan"
                tools:text="62.0 mm" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/ipdSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:valueFrom="50.0"
            android:valueTo="75.0"
            android:stepSize="0.5"
            android:value="62.0"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_ipd_min"
                android:textSize="11sp"
                android:textColor="@color/setup_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_ipd_max"
                android:textSize="11sp"
                android:textColor="@color/setup_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ipdMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/settings_ipd_minus"
                android:textSize="13sp"
                android:textColor="@color/setup_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/setup_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ipdPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_ipd_plus"
                android:textSize="13sp"
                android:textColor="@color/setup_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/setup_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ipdReset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/settings_ipd_reset"
            android:textSize="12sp"
            android:textColor="@color/setup_cyan"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ipd_note"
            android:textSize="11sp"
            android:textColor="@color/setup_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/setup_divider" />

        <!-- 重定「正前方」倒计时 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_align_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/setup_text" />

            <TextView
                android:id="@+id/alignValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/setup_cyan"
                tools:text="10 秒" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alignMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/settings_align_minus"
                android:textSize="13sp"
                android:textColor="@color/setup_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/setup_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alignPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_align_plus"
                android:textSize="13sp"
                android:textColor="@color/setup_text"
                app:cornerRadius="12dp"
                app:strokeColor="@color/setup_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_align_note"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/setup_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_done"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/setup_deep"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/setup_cyan" />

    </LinearLayout>
</ScrollView>
