<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.7「一看就明白、能不填就不填」。
  第一屏不再让用户在六种协议里挑一个、再回想自己 NAS 的 IP。
  默认只有两个动作——「手机里的视频」「同一 Wi-Fi 下的设备」，都不需要输入；
  手填地址收进默认折叠的「找不到设备？手动添加」，只作兜底。
  方向 A 深色令牌不变，从平面到戴镜不换风格。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/setup_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- 品牌行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="24dp"
                    android:background="@color/brand_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/setup_brand"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/setup_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/setup_brand_cn"
                    android:textSize="12sp"
                    android:textColor="@color/setup_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/setup_big"
                android:textSize="29sp"
                android:textStyle="bold"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/setup_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_kicker"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="@color/setup_muted" />

            <!-- 入口 1：手机里的视频。零输入，点一下就把整机视频收进来 -->
            <LinearLayout
                android:id="@+id/localCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@drawable/bg_setup_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_local_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/localChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_setup_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/setup_local_chip"
                        android:textSize="11sp"
                        android:textColor="@color/setup_cyan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/localHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setup_local_hint"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/setup_muted" />
            </LinearLayout>

            <!-- 入口 2：同一 Wi-Fi 下的设备。自动发现，不用填 IP -->
            <LinearLayout
                android:id="@+id/lanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_setup_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_lan_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/lanChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_setup_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/setup_lan_chip"
                        android:textSize="11sp"
                        android:textColor="@color/setup_cyan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lanHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setup_lan_hint"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/setup_muted" />
            </LinearLayout>

            <!-- 四态内联反馈：不弹 Toast，状态就留在原地 -->
            <LinearLayout
                android:id="@+id/statusBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_setup_box">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_setup_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/statusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_setup_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="11sp"
                    android:textColor="@color/setup_muted" />
            </LinearLayout>

            <!-- 已添加的片库 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_sources_ready"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/setup_text" />

                <TextView
                    android:id="@+id/sourceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/setup_muted" />

                <!-- V2.18：用户真机反馈「加第二个文件夹根本不知道怎么操作」。
                     原来唯一入口是底下的「手动添加」折叠区，位置在列表之后、文案又像设置项。
                     这里在片库标题行直接给一个「＋ 加片库」，和已有的片库放在一起。 -->
                <TextView
                    android:id="@+id/sourceAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="56dp"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_setup_chip"
                    android:text="@string/setup_add_source"
                    android:textSize="12sp"
                    android:textColor="@color/setup_cyan" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- 兜底：手动添加，默认折叠。只有自动发现不到时才需要展开 -->
            <TextView
                android:id="@+id/manualToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/setup_manual_toggle"
                android:textSize="12sp"
                android:textColor="@color/setup_muted"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/manualBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/bg_setup_box">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_share_type"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/setup_muted" />

                <Spinner
                    android:id="@+id/shareType"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_setup_field"
                    android:popupBackground="@color/setup_card"
                    android:entries="@array/share_types" />

                <!-- V2.6：地址块整体可隐藏。DLNA 自动发现不该出现一个空输入框 -->
                <LinearLayout
                    android:id="@+id/addressBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/setup_address"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/setup_muted" />

                    <EditText
                        android:id="@+id/shareAddress"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_setup_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textUri"
                        android:textSize="13sp"
                        android:textColor="@color/setup_text"
                        android:textColorHint="@color/setup_muted"
                        android:hint="@string/setup_address_hint"
                        android:singleLine="true"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <TextView
                    android:id="@+id/addressHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/setup_address_help"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/setup_muted" />

                <CheckBox
                    android:id="@+id/scanNoSubfolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checked="false"
                    android:buttonTint="@color/setup_cyan"
                    android:text="@string/setup_no_subfolders"
                    android:textSize="13sp"
                    android:textColor="@color/setup_text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_username"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:textColor="@color/setup_muted" />

                        <EditText
                            android:id="@+id/shareUser"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_setup_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp"
                            android:textColor="@color/setup_text"
                            android:textColorHint="@color/setup_muted"
                            android:inputType="text"
                            android:singleLine="true"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_password"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:textColor="@color/setup_muted" />

                        <EditText
                            android:id="@+id/sharePass"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_setup_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp"
                            android:textColor="@color/setup_text"
                            android:textColorHint="@color/setup_muted"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/setup_scan"
                    android:textSize="14sp"
                    android:textColor="@color/setup_cyan"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/setup_border"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 主 CTA 常驻首屏，不随内容滚动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@color/setup_bg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterVrButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/setup_enter"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/setup_deep"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/setup_cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/setup_foot"
            android:textSize="11sp"
            android:textColor="@color/setup_muted" />

        <!--
          V2.34：底部一行小字，两个次要入口并排。
          「设置」是戴镜前调瞳距的地方（原先只有戴镜后能调），
          「运行日志」仍是出问题才点一次的兜底入口——两个都不许抢主行动的权重。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal"
            android:baselineAligned="true">

            <!-- V2.7.4 测试版：出问题直接截图这一页 -->
            <TextView
                android:id="@+id/settingsEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:text="@string/settings_entry"
                android:textSize="11sp"
                android:textColor="@color/setup_cyan"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/setup_border" />

            <TextView
                android:id="@+id/logEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:gravity="center"
                android:text="@string/setup_log_entry"
                android:textSize="11sp"
                android:textColor="@color/setup_muted"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
