<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.45：手机端（非 VR）首屏重做。

  上一版的问题不是「不好看」，是**一屏里全是字**：品牌行、29sp 主张句、kicker、
  两张各带两行 11sp 说明的卡、常驻状态条（标题 + 两行说明 + 胶囊）、片库标题、
  折叠表单、底部说明、两个 11sp 次要入口。用户得先读完一页才敢点第一下。
  而且「设置」藏在底部 CTA 下面，「删除」和「重扫」是 32dp 高的小字并排。

  这一版只留两件事：现在该做什么 / 已经有什么。
  · 顶栏：品牌 + 两个 48dp 图标入口（设置、日志），不再用 11sp 小字藏起来；
  · 两张大卡：图标 + 一行短说明 + 状态胶囊，minHeight 76dp，按下去有水波纹；
  · 状态条：空闲时整块隐藏，只有「忙 / 出错 / 有结果」才出现，不再常驻解释「点一个就行」；
  · 加片库：点标题行的按钮直接弹对话框，不再滚到页面下面展开折叠区；
  · 底部：只剩一个 56dp 主行动，凭证说明挪走。

  横屏用 layout-land/activity_setup.xml，两栏重排但**共用同一套 id 与设计语言**。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/setup_bg">

    <!-- 顶栏：品牌 + 两个常驻的次要入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="3dp"
            android:layout_height="22dp"
            android:background="@color/brand_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/setup_brand"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/setup_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/setup_brand_cn"
            android:textSize="12sp"
            android:textColor="@color/setup_muted" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settingsEntry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_setup_settings"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings" />

        <ImageButton
            android:id="@+id/logEntry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_setup_log"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_log" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setup_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_big"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/setup_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_sub"
                android:textSize="12sp"
                android:textColor="@color/setup_muted" />

            <!-- 入口 1：手机里的视频 -->
            <LinearLayout
                android:id="@+id/localCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="76dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_setup_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_setup_icon_tile">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setup_phone"
                        android:contentDescription="@string/setup_local_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_local_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/setup_local_short"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/localChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_setup_chip_solid"
                    android:text="@string/setup_local_chip"
                    android:textSize="12sp"
                    android:textColor="@color/setup_cyan" />
            </LinearLayout>

            <!-- 入口 2：同一 Wi-Fi 下的设备 -->
            <LinearLayout
                android:id="@+id/lanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="76dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_setup_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_setup_icon_tile">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setup_wifi"
                        android:contentDescription="@string/setup_lan_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_lan_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/setup_lan_short"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lanChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_setup_chip_solid"
                    android:text="@string/setup_lan_chip"
                    android:textSize="12sp"
                    android:textColor="@color/setup_cyan" />
            </LinearLayout>

            <!-- 四态反馈：空闲时整块隐藏，忙 / 出错 / 有结果才出现。
                 点它还能展开上次进 VR 的崩溃详情（见 showLastCrash）。 -->
            <LinearLayout
                android:id="@+id/statusBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="52dp"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/bg_setup_strip">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_setup_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/statusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_setup_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="11sp"
                    android:textColor="@color/setup_muted" />
            </LinearLayout>

            <!-- 我的片库：标题 + 真实视频数 + 一个 44dp 的「＋ 加片库」 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_sources_ready"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/sourceCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sourceAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="100dp"
                    android:gravity="center"
                    android:background="@drawable/bg_setup_action"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/setup_add_source"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/setup_cyan"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- 兜底入口，和「＋ 加片库」一样开同一个对话框 -->
            <TextView
                android:id="@+id/manualToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:text="@string/setup_manual_toggle"
                android:textSize="12sp"
                android:textColor="@color/setup_muted"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

    <!-- 主行动常驻首屏，不随内容滚动 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setup_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@color/setup_bg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterVrButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/setup_enter"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/setup_deep"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/setup_cyan" />
    </LinearLayout>

</LinearLayout>
