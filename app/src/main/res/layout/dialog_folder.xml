<?xml version="1.0" encoding="utf-8"?>
<!-- V2.45：选文件夹对话框。地址全程程序维护，用户只点看得见的目录名；
     所有按钮 48dp，返回上一层不再是一个 34dp 的小 chip。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/setup_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/setup_text" />

    <TextView
        android:id="@+id/folderCrumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="middle"
        android:textColor="@color/setup_muted" />

    <TextView
        android:id="@+id/folderNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/setup_muted" />

    <TextView
        android:id="@+id/folderUp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:minWidth="112dp"
        android:gravity="center"
        android:background="@drawable/bg_setup_action"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/folder_up"
        android:textSize="13sp"
        android:textColor="@color/setup_cyan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/folderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/folder_cancel"
            android:textSize="13sp"
            android:textColor="@color/setup_text"
            app:cornerRadius="12dp"
            app:strokeColor="@color/setup_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderChoose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:layout_marginStart="8dp"
            android:text="@string/folder_choose"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/setup_deep"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/setup_cyan" />
    </LinearLayout>

</LinearLayout>
