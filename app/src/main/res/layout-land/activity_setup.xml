<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.45 横屏：和竖屏是同一个界面换一种排法，不是另一个 App。
  · 顶栏品牌组、图标入口、主行动按钮与竖屏一致；
  · 左栏「现在该做什么」，右栏「已经有什么」，中间一道细线；
  · 状态条贴底通栏，横屏最缺高度，一行就够；
  · 加片库一律弹对话框，两个方向都不再有折叠表单。
  所有 id 与 layout/activity_setup.xml 一致，onConfigurationChanged 换整套 view 后照常重绑。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/setup_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="3dp"
            android:layout_height="22dp"
            android:background="@color/brand_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/setup_brand"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/setup_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/setup_brand_cn"
            android:textSize="12sp"
            android:textColor="@color/setup_muted" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settingsEntry"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_setup_settings"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings" />

        <ImageButton
            android:id="@+id/logEntry"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_setup_log"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterVrButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="146dp"
            android:text="@string/setup_enter"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/setup_deep"
            app:backgroundTint="@color/setup_cyan"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setup_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 左栏：现在该做什么 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_big"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/setup_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/setup_sub"
                    android:textSize="11sp"
                    android:textColor="@color/setup_muted" />

                <LinearLayout
                    android:id="@+id/localCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:minHeight="72dp"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_setup_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_setup_icon_tile">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_setup_phone"
                            android:contentDescription="@string/setup_local_title" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_local_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setup_local_short"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/setup_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/localChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_setup_chip_solid"
                        android:text="@string/setup_local_chip"
                        android:textSize="11sp"
                        android:textColor="@color/setup_cyan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="72dp"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_setup_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_setup_icon_tile">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_setup_wifi"
                            android:contentDescription="@string/setup_lan_title" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_lan_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setup_lan_short"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/setup_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lanChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_setup_chip_solid"
                        android:text="@string/setup_lan_chip"
                        android:textSize="11sp"
                        android:textColor="@color/setup_cyan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/manualToggle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/setup_manual_toggle"
                    android:textSize="12sp"
                    android:textColor="@color/setup_muted"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/setup_divider" />

        <!-- 右栏：已经有什么 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_sources_ready"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:id="@+id/sourceCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:textColor="@color/setup_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sourceAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="100dp"
                        android:gravity="center"
                        android:background="@drawable/bg_setup_action"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/setup_add_source"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_cyan"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sourceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 状态条贴底：空闲隐藏，一行写完 -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/bg_setup_strip">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_setup_dot" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/setup_text" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/setup_muted" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_setup_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textColor="@color/setup_muted" />
    </LinearLayout>

</LinearLayout>
