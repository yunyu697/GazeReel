<?xml version="1.0" encoding="utf-8"?>
<!--
  V2.17 横屏布局。

  用户原话：「APP 界面同时也适配横屏，因为 VR 使用的场景都是横屏，每次退出必须返回竖屏，
  体验很割裂，注意布局也要按横屏重排，不要简单拉伸一下敷衍了事」。

  所以这里不是把竖屏那一列拉宽，而是重排成左右两栏：
  - 左栏「先做什么」：两个大入口 + 状态条。手机横着拿时它们在手边，一屏可见；
  - 右栏「已经有什么」：片库列表 + 手动添加。列表独立滚动，不会把左栏顶走。

  顶栏把品牌、进入 VR、日志收进一条窄带——横屏最缺的就是高度，不能拿它放标题。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/setup_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 顶栏：品牌 + 进入 VR + 日志 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_brand"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/brand_cyan"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_big"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:textColor="@color/setup_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/logEntry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_setup_chip"
            android:text="@string/setup_log_entry"
            android:textSize="12sp"
            android:textColor="@color/setup_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterVrButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="40dp"
            android:text="@string/setup_enter"
            android:textSize="13sp"
            android:textColor="@color/setup_bg"
            app:backgroundTint="@color/brand_cyan"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 两栏主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 左栏：先做什么 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/localCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_setup_box">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_local_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:id="@+id/localChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_setup_chip"
                            android:text="@string/setup_local_chip"
                            android:textSize="11sp"
                            android:textColor="@color/setup_cyan" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/localHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/setup_local_hint"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_setup_box">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_lan_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:id="@+id/lanChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_setup_chip"
                            android:text="@string/setup_lan_chip"
                            android:textSize="11sp"
                            android:textColor="@color/setup_cyan" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lanHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/setup_lan_hint"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>

                <!-- 四态状态条：位置永远不动 -->
                <LinearLayout
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_setup_box">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_setup_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/setup_text" />

                        <TextView
                            android:id="@+id/statusDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/setup_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/bg_setup_chip"
                        android:textSize="11sp"
                        android:textColor="@color/setup_muted" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 右栏：已经有什么 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_sources_ready"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/setup_text" />

                    <TextView
                        android:id="@+id/sourceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/setup_muted" />

                    <!-- V2.18：加片库的入口必须和已有片库放在一起，不能藏在列表下面。 -->
                    <TextView
                        android:id="@+id/sourceAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="56dp"
                        android:minHeight="32dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_setup_chip"
                        android:text="@string/setup_add_source"
                        android:textSize="11sp"
                        android:textColor="@color/setup_cyan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sourceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/manualToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_setup_chip"
                    android:text="@string/setup_manual_toggle"
                    android:textSize="12sp"
                    android:textColor="@color/setup_muted" />

                <LinearLayout
                    android:id="@+id/manualBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_setup_box">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_share_type"
                        android:textSize="11sp"
                        android:textColor="@color/setup_muted" />

                    <Spinner
                        android:id="@+id/shareType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="44dp"
                        android:background="@drawable/bg_setup_field" />

                    <LinearLayout
                        android:id="@+id/addressBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/setup_address"
                            android:textSize="11sp"
                            android:textColor="@color/setup_muted" />

                        <EditText
                            android:id="@+id/shareAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="44dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/bg_setup_field"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:textSize="13sp"
                            android:textColor="@color/setup_text"
                            android:autofillHints=""
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/addressHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/setup_address_help"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/setup_muted" />

                    <CheckBox
                        android:id="@+id/scanNoSubfolders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="false"
                        android:buttonTint="@color/setup_cyan"
                        android:text="@string/setup_no_subfolders"
                        android:textSize="13sp"
                        android:textColor="@color/setup_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_username"
                                android:textSize="11sp"
                                android:textColor="@color/setup_muted" />

                            <EditText
                                android:id="@+id/shareUser"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:minHeight="44dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/bg_setup_field"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textSize="13sp"
                                android:textColor="@color/setup_text"
                                android:autofillHints=""
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_password"
                                android:textSize="11sp"
                                android:textColor="@color/setup_muted" />

                            <EditText
                                android:id="@+id/sharePass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:minHeight="44dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/bg_setup_field"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textSize="13sp"
                                android:textColor="@color/setup_text"
                                android:autofillHints=""
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="44dp"
                        android:text="@string/setup_scan"
                        android:textSize="13sp"
                        android:textColor="@color/setup_cyan"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/setup_border"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
