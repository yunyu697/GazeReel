<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网串流 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 阶段二：DLNA/UPnP 的 SSDP 组播发现需要持有 Wi-Fi 组播锁 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- PRD NET-06：前台服务持有 Wi-Fi / CPU 唤醒锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 本地 / OTG 片源 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- 头追与手势依赖陀螺仪；没有陀螺仪的设备无法保证凝视通道精度 -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GazeReel">

        <!-- 戴镜前：所有文本输入、共享配置、片库扫描都在这里完成。
             V2.17：不再锁竖屏——VR 场景都是横屏，每次退出都转回竖屏太割裂。
             横屏有独立布局 layout-land/activity_setup.xml（左右两栏重排，不是拉伸）。 -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V2.7.4 测试版：运行日志页，用户直接截图反馈 -->
        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/log_title" />

        <!-- 戴镜后：全屏横屏、锁定方向，不响应键盘输入 -->
        <activity
            android:name=".ui.VrActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.GazeReel.Immersive" />

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
